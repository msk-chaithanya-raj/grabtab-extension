{
  "manifest_version": 3,
  "name": "Grab N Download",
  "version": "1.0.0",
  "description": "Download all images and tables from any webpage with one click",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "favicon-16x16.png",
      "32": "favicon-32x32.png"
    }
  },
  "icons": {
    "16": "favicon-16x16.png",
    "32": "favicon-32x32.png"
  },
  "permissions": ["activeTab", "storage", "downloads", "notifications"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
